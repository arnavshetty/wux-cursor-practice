# Mux API (Video Read + Write) — https://dashboard.mux.com/settings/access-tokens
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Required in production — https://dashboard.mux.com/settings/webhooks
# URL: https://your-domain.com/api/webhooks/mux
MUX_WEBHOOK_SIGNING_SECRET=

# Public site URL (https:// in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: persistent SQLite path (Docker/volume)
# DATABASE_PATH=/data/mux-practice.db

# Optional: override dev CORS for direct uploads (default "*" in development)
# MUX_CORS_ORIGIN=http://localhost:3000
